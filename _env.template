# PathScore Environment Configuration Template
# Copy this file to .env and customize for your environment
#
# Usage:
#   cp _env.template .env
#   # Edit .env with your values
#   docker compose up -d

# =============================================================================
# Flask Configuration
# =============================================================================
FLASK_CONFIG=development    # development, testing, or production
SECRET_KEY=change-me-to-a-secure-random-string

# =============================================================================
# Database (MySQL)
# =============================================================================
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_USER=www
MYSQL_PASSWORD=change-me-user-password
MYSQL_PORT=3307             # Host port mapping (container uses 3306)

# =============================================================================
# Parallel Execution Mode
# =============================================================================
# Options:
#   off     - Synchronous execution (blocking, for debugging)
#   threads - Background threads (no Celery/Redis required)
#   celery  - Full task queue (requires Redis)
PARALLEL_MODE=threads

# =============================================================================
# Redis (only needed when PARALLEL_MODE=celery)
# =============================================================================
REDIS_PORT=6379

# =============================================================================
# Flask Web Server
# =============================================================================
FLASK_PORT=5000

# =============================================================================
# Security (Flask-Security-Too)
# =============================================================================
SECURITY_PASSWORD_SALT=change-me-to-random-salt
SECURITY_CONFIRMABLE=False   # Require email confirmation for registration
SECURITY_REGISTERABLE=True   # Allow new user registration
SECURITY_CHANGEABLE=True     # Allow password changes

# =============================================================================
# Email Configuration (optional - for notifications and password reset)
# =============================================================================
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=noreply@example.com
MAIL_ERROR_RECIPIENT=admin@example.com

# =============================================================================
# Local/Single-User Mode (Future Feature)
# =============================================================================
# When enabled, bypasses authentication and treats all projects as belonging
# to a single local user. Useful for personal/local installations.
LOCAL_MODE=false

# =============================================================================
# Analytics (optional)
# =============================================================================
ANALYTICS_ID=
